{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.onfra.xyz/schemas/chatRequest.schema.json",
  "title": "Chat Query Request",
  "description": "Natural-language question about a wallet's finances, answered from OnFRA's analysis. Costs 0.01 USDT via x402.",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "description": "Question about a wallet's financial activity."
    },
    "wallet_address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "description": "Target wallet. Required for wallet-specific questions."
    },
    "chain": {
      "type": "string",
      "enum": [
        "celo"
      ],
      "description": "Blockchain. Celo today; more EVM chains planned."
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "message"
  ],
  "additionalProperties": false,
  "x-price-usdt": "0.01"
}
