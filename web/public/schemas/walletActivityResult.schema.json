{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.onfra.xyz/schemas/walletActivityResult.schema.json",
  "title": "Wallet Activity Result",
  "description": "How active a wallet is, independent of financial value.",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "chain": {
      "type": "string",
      "description": "Blockchain analyzed, e.g. celo."
    },
    "period": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "Requested period, e.g. 30d or 2026-10."
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "complete": {
          "type": "boolean",
          "description": "False if the window is only partially elapsed."
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "start",
        "end"
      ],
      "description": "Period covered by this result."
    },
    "activity": {
      "type": "object",
      "properties": {
        "transaction_count": {
          "type": "integer",
          "minimum": 0,
          "x-origin": "observed"
        },
        "active_days": {
          "type": "integer",
          "minimum": 0,
          "x-origin": "calculated"
        },
        "average_transactions_per_active_day": {
          "type": "number",
          "x-origin": "calculated"
        },
        "first_activity": {
          "type": "string",
          "format": "date",
          "description": "First activity within the period."
        },
        "last_activity": {
          "type": "string",
          "format": "date",
          "description": "Most recent activity within the period."
        }
      },
      "additionalProperties": false,
      "required": [
        "transaction_count",
        "active_days",
        "average_transactions_per_active_day"
      ]
    },
    "activity_pattern": {
      "type": "object",
      "properties": {
        "frequency": {
          "type": "string",
          "enum": [
            "dormant",
            "sporadic",
            "regular",
            "frequent"
          ],
          "x-origin": "classified"
        },
        "trend": {
          "type": "string",
          "enum": [
            "increasing",
            "stable",
            "decreasing"
          ],
          "x-origin": "classified"
        }
      },
      "additionalProperties": false,
      "required": [
        "frequency",
        "trend"
      ]
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "OnFRA's plain-language interpretation. Not facts recorded on the blockchain.",
      "x-origin": "interpreted"
    },
    "data_source": {
      "type": "string",
      "description": "Where the underlying data came from."
    },
    "data_last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Latest data point included."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_quality": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean",
          "description": "True if all data for the period was retrieved and processed."
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Known gaps or caveats (missing prices, unlabeled addresses, partial window, etc.)."
        }
      },
      "additionalProperties": false,
      "required": [
        "complete",
        "limitations"
      ],
      "description": "Data quality and limitations."
    }
  },
  "required": [
    "wallet_address",
    "chain",
    "period",
    "activity",
    "activity_pattern",
    "generated_at",
    "data_quality"
  ],
  "additionalProperties": false,
  "x-origin-legend": {
    "observed": "Read directly from the blockchain.",
    "calculated": "Totals, averages and percentages computed by OnFRA.",
    "classified": "Categories or labels assigned by OnFRA, sometimes with confidence.",
    "interpreted": "OnFRA's plain-language interpretation."
  }
}
