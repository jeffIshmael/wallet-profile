{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.onfra.xyz/schemas/cashFlowSummaryResult.schema.json",
  "title": "Cash Flow Summary Result",
  "description": "Inflow, outflow and net flow for a period.",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "chain": {
      "type": "string",
      "description": "Blockchain analyzed, e.g. celo."
    },
    "period": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "Requested period, e.g. 30d or 2026-10."
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "complete": {
          "type": "boolean",
          "description": "False if the window is only partially elapsed."
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "start",
        "end"
      ],
      "description": "Period covered by this result."
    },
    "currency": {
      "type": "string"
    },
    "cash_flow": {
      "type": "object",
      "properties": {
        "total_inflow": {
          "type": "number",
          "x-origin": "calculated"
        },
        "total_outflow": {
          "type": "number",
          "x-origin": "calculated"
        },
        "net_flow": {
          "type": "number",
          "x-origin": "calculated"
        }
      },
      "additionalProperties": false,
      "required": [
        "total_inflow",
        "total_outflow",
        "net_flow"
      ]
    },
    "transaction_counts": {
      "type": "object",
      "properties": {
        "incoming": {
          "type": "integer",
          "minimum": 0,
          "x-origin": "observed"
        },
        "outgoing": {
          "type": "integer",
          "minimum": 0,
          "x-origin": "observed"
        }
      },
      "additionalProperties": false,
      "required": [
        "incoming",
        "outgoing"
      ]
    },
    "averages": {
      "type": "object",
      "properties": {
        "daily_inflow": {
          "type": "number",
          "x-origin": "calculated"
        },
        "daily_outflow": {
          "type": "number",
          "x-origin": "calculated"
        }
      },
      "additionalProperties": false,
      "required": [
        "daily_inflow",
        "daily_outflow"
      ]
    },
    "trend": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ],
      "x-origin": "classified"
    },
    "methodology": {
      "type": "object",
      "properties": {
        "internal_transfers": {
          "type": "string",
          "enum": [
            "excluded",
            "included"
          ],
          "description": "Transfers between wallets OnFRA can attribute to the same owner."
        },
        "self_transfers": {
          "type": "string",
          "enum": [
            "excluded",
            "included"
          ]
        },
        "swaps": {
          "type": "string",
          "enum": [
            "excluded",
            "counted_as_flow",
            "net_value_only"
          ],
          "description": "How token swaps were treated."
        },
        "gas_fees": {
          "type": "string",
          "enum": [
            "excluded",
            "included_in_outflow"
          ]
        },
        "failed_transactions": {
          "type": "string",
          "enum": [
            "excluded",
            "gas_only"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "internal_transfers",
        "self_transfers",
        "swaps",
        "gas_fees",
        "failed_transactions"
      ],
      "description": "How edge cases were handled, so the totals can be interpreted correctly."
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "OnFRA's plain-language interpretation. Not facts recorded on the blockchain.",
      "x-origin": "interpreted"
    },
    "data_source": {
      "type": "string",
      "description": "Where the underlying data came from."
    },
    "data_last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Latest data point included."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_quality": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean",
          "description": "True if all data for the period was retrieved and processed."
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Known gaps or caveats (missing prices, unlabeled addresses, partial window, etc.)."
        }
      },
      "additionalProperties": false,
      "required": [
        "complete",
        "limitations"
      ],
      "description": "Data quality and limitations."
    }
  },
  "required": [
    "wallet_address",
    "chain",
    "period",
    "currency",
    "cash_flow",
    "transaction_counts",
    "averages",
    "trend",
    "methodology",
    "insights",
    "generated_at",
    "data_quality"
  ],
  "additionalProperties": false,
  "x-origin-legend": {
    "observed": "Read directly from the blockchain.",
    "calculated": "Totals, averages and percentages computed by OnFRA.",
    "classified": "Categories or labels assigned by OnFRA, sometimes with confidence.",
    "interpreted": "OnFRA's plain-language interpretation."
  }
}
