        "type": "object",
        "required": [
          "wallet_address",
          "chain",
          "period"
        ],
        "properties": {
          "wallet_address": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "Wallet address to analyze."
          },
          "chain": {
            "type": "string",
            "enum": [
              "celo"
            ],
            "description": "Blockchain. Celo today; more EVM chains planned."
          },
          "period": {
            "type": "string",
            "description": "Period such as 7d, 30d, 90d or 1y. Ignored if start_date and end_date are given."
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Custom start date (YYYY-MM-DD)."
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Custom end date (YYYY-MM-DD)."
          },
          "currency": {
            "type": "string",
            "default": "USD",
            "description": "Reporting currency."
          }
        }
      },
      "inputSchemaUrl": "https://app.onfra.xyz/schemas/get_cash_flow_summaryRequest.schema.json",
      "outputSchemaUrl": "https://app.onfra.xyz/schemas/cashFlowSummaryResult.schema.json",
      "access": "free",
      "priceUsdt": "0",
      "route": {
        "method": "POST",
        "path": "/api/agent/tools/get_cash_flow_summary"
      }
    },
    {
      "name": "get_token_balances",
