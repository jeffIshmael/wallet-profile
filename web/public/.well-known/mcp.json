{
  "name": "OnFRA — Onchain Financial Intelligence Agent",
  "version": "2026-11-05",
  "description": "MCP discovery for OnFRA. Turns Celo wallet activity into structured financial intelligence: wallet profiles, cash flow, token balances and breakdowns, spending, counterparties, activity, period comparisons, transaction explanations and statements. Most tools are free; transaction explanations and statements are paid via x402 for agents and API clients. https://app.onfra.xyz",
  "auth": {
    "scheme": "x402",
    "model": "free tools plus pay-per-request",
    "apiKeyRequired": false,
    "chain": "celo",
    "network": "celo",
    "chainId": 42220,
    "currency": "0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e",
    "currencySymbol": "USDT",
    "paymentHeader": "X-PAYMENT",
    "alternateHeaders": [
      "PAYMENT-SIGNATURE",
      "x-payment"
    ],
    "configUrl": "https://app.onfra.xyz/api/x402/config",
    "healthUrl": "https://app.onfra.xyz/api/health/integrations",
    "capabilitiesUrl": "https://app.onfra.xyz/api/capabilities",
    "pricing": {
      "model": "free tools plus pay-per-request for two tools",
      "free_tools": [
        "analyze_wallet",
        "get_cash_flow_summary",
        "get_token_balances",
        "get_token_breakdown",
        "compare_periods",
        "get_spending_breakdown",
        "get_dominant_counterparties",
        "get_wallet_activity"
      ],
      "paid_tools": {
        "generate_transaction_statement": "0.01 USDT",
        "explain_transaction": "0.02 USDT"
      },
      "in_app": "Free inside the OnFRA app at app.onfra.xyz (rate limited). Agents and API clients pay the listed price via x402.",
      "chat_query": "0.01 USDT for external wallets; free for the caller's own wallet in the app.",
      "discovery_endpoints": "free"
    },
    "paymentRequired": {
      "httpStatus": 402,
      "code": "PAYMENT_REQUIRED",
      "bodyFields": [
        "payTo",
        "asset",
        "priceUsdt",
        "maxAmountRequired",
        "network",
        "chainId",
        "paymentHeader",
        "accepts",
        "retry"
      ],
      "example": {
        "error": "Payment Required",
        "code": "PAYMENT_REQUIRED",
        "scheme": "x402",
        "network": "celo",
        "chainId": 42220,
        "asset": "0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e",
        "currencySymbol": "USDT",
        "priceUsdt": "0.02",
        "maxAmountRequired": "20000",
        "payTo": "<from /api/x402/config>",
        "paymentHeader": "X-PAYMENT",
        "accepts": [
          {
            "scheme": "x402",
            "network": "celo",
            "chainId": 42220,
            "maxAmountRequired": "20000",
            "asset": "0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e",
            "payTo": "<treasury>"
          }
        ],
        "retry": {
          "method": "resubmit",
          "header": "X-PAYMENT",
          "steps": [
            "Read accepts[0] (asset, maxAmountRequired, payTo, network).",
            "Sign EIP-3009 USDT authorization for maxAmountRequired to payTo.",
            "Retry the same HTTP request with X-PAYMENT set to the payment payload."
          ]
        }
      }
    }
  },
  "responseConventions": {
    "format": "Structured JSON, never prose only.",
    "originTags": {
      "description": "Every field in the result schemas carries an x-origin tag.",
      "observed": "Read directly from the blockchain.",
      "calculated": "Totals, averages and percentages computed by OnFRA.",
      "classified": "Categories or labels assigned by OnFRA, sometimes with confidence.",
      "interpreted": "OnFRA's plain-language interpretation."
    },
    "provenance": [
      "period",
      "data_source",
      "data_last_updated",
      "generated_at",
      "data_quality.limitations"
    ]
  },
  "onChainActions": [
    "USDT x402 settlement to payTo on Celo (paid tools only)",
    "Buy gateway purchase of a Chainstack call trace (explain_transaction, complex transactions only)",
    "ERC-8004 agent #9219 identity"
  ],
  "tools": [
    {
      "name": "analyze_wallet",
      "description": "Flagship tool. Returns a structured financial intelligence profile of a wallet: overview, financial summary, token overview, activity level, insights and data quality. Observed data, calculated metrics, classifications and insights are kept separate. Free (fair-use rate limits apply).",
      "inputSchema": {
        "type": "object",
        "required": [
          "wallet_address",
          "chain"
        ],
        "properties": {
          "wallet_address": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "Wallet address to analyze."
          },
          "chain": {
            "type": "string",
            "enum": [
              "celo"
            ],
            "description": "Blockchain. Celo today; more EVM chains planned."
          },
          "period": {
            "type": "string",
            "description": "Analysis period: 7d, 30d, 90d, 1y or all-time."
          }
        }
      },
      "inputSchemaUrl": "https://app.onfra.xyz/schemas/analyze_walletRequest.schema.json",
      "outputSchemaUrl": "https://app.onfra.xyz/schemas/walletAnalysisResult.schema.json",
      "access": "free",
      "priceUsdt": "0",
      "route": {
        "method": "POST",
        "path": "/api/agent/tools/analyze_wallet"
      }
    },
    {
      "name": "get_cash_flow_summary",
      "description": "Total inflow, outflow and net flow for a period, with transaction counts, daily averages and trend. Internal transfers, swaps, self-transfers, gas and failed transactions are handled explicitly and reported in data_quality. Free (fair-use rate limits apply).",
