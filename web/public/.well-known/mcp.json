    {
      "name": "compare_periods",
      "description": "Compares financial activity between two equivalent time windows: inflow, outflow, net flow and transaction count, with percentage change and insights. Incomplete windows are flagged, never silently compared. Free (fair-use rate limits apply).",
      "inputSchema": {
        "type": "object",
        "required": [
          "wallet_address",
          "chain",
          "current_period",
          "previous_period"
        ],
        "properties": {
          "wallet_address": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "Wallet address to analyze."
          },
          "chain": {
            "type": "string",
            "enum": [
              "celo"
            ],
            "description": "Blockchain. Celo today; more EVM chains planned."
          },
          "current_period": {
            "type": "string",
            "description": "Period being evaluated: a named period (30d), a month (2026-10) or an explicit range (YYYY-MM-DD/YYYY-MM-DD)."
          },
          "previous_period": {
            "type": "string",
            "description": "Period to compare against, same formats as current_period."
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "inflow",
                "outflow",
                "net_flow",
                "transaction_count"
              ]
            },
            "description": "Metrics to compare. Defaults to all supported metrics."
          }
        }
      },
      "inputSchemaUrl": "https://app.onfra.xyz/schemas/compare_periodsRequest.schema.json",
      "outputSchemaUrl": "https://app.onfra.xyz/schemas/comparePeriodsResult.schema.json",
      "access": "free",
      "priceUsdt": "0",
      "route": {
        "method": "POST",
        "path": "/api/agent/tools/compare_periods"
      }
    },
    {
      "name": "explain_transaction",
      "description": "Explains what happened in a specific transaction in plain language: type, amounts, parties, gas, classification with confidence, and warnings. Handles transfers, swaps, contract calls, liquidity, NFTs, bridges and failed transactions. States uncertainty rather than inventing a purpose. Costs 0.02 USDT via x402 when called by an agent or API client; free inside the OnFRA app.",
      "inputSchema": {
        "type": "object",
        "required": [
          "transaction_hash",
          "chain"
        ],
        "properties": {
          "transaction_hash": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{64}$",
            "description": "Transaction hash."
          },
          "chain": {
            "type": "string",
            "enum": [
              "celo"
            ],
            "description": "Blockchain. Celo today; more EVM chains planned."
          },
          "wallet_address": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "Optional wallet whose perspective should be used."
          },
          "use_trace": {
            "type": "boolean",
            "default": true,
            "description": "Allow buying a call trace (through Buy) when the transaction is complex. Disable to avoid the extra data purchase."
          }
        }
      },
      "inputSchemaUrl": "https://app.onfra.xyz/schemas/explain_transactionRequest.schema.json",
      "outputSchemaUrl": "https://app.onfra.xyz/schemas/explainTransactionResult.schema.json",
      "access": "x402",
      "priceUsdt": "0.02",
      "route": {
        "method": "POST",
        "path": "/api/agent/tools/explain_transaction"
      }
    },
