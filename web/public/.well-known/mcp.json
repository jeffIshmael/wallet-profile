      "outputSchemaUrl": "https://app.onfra.xyz/schemas/tokenBalancesResult.schema.json",
      "access": "free",
      "priceUsdt": "0",
      "route": {
        "method": "POST",
        "path": "/api/agent/tools/get_token_balances"
      }
    },
    {
