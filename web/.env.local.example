# Get your app ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Public base URL for agent manifests and verification links
NEXT_PUBLIC_APP_URL=https://wallet-profile-orpin.vercel.app

# Enable x402 payment enforcement on paid agent endpoints
# X402_ENFORCE=true
# THIRDWEB_SECRET_KEY=your-thirdweb-secret

# OnchainReporter (Celo mainnet) — backend relayer for publishFinancialReport
REPORTER_PRIVATE_KEY=your-reporter-private-key
ONCHAIN_REPORTER_PROXY_ADDRESS=0x50a8Fc322497e2EAc5489A64ce162E07Fb85E6AB
# CELO_RPC_URL=https://forno.celo.org
