# Pooled connection for app runtime (Supabase transaction pooler, port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct/session connection for Prisma CLI migrations & studio (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Get your app ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
# Privy Dashboard → Wallet infrastructure → Gas sponsorship:
# enable sponsorship, add Celo (42220), allow client-side txs, fund gas credits.
# NEXT_PUBLIC_PRIVY_SPONSOR_GAS=false  # optional: disable sponsor:true in client txs

# Public base URL for agent manifests and verification links
NEXT_PUBLIC_APP_URL=https://app.onfra.xyz
# OnFRA marketing site (onfra.xyz / local dev on :3001)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# OpenAI — powers OnFRA chat + dashboard AI summaries
OPENAI_API_KEY=your-openai-api-key

# Thirdweb — x402 micropayment settlement on Celo
THIRDWEB_SECRET_KEY=your-thirdweb-secret-key
THIRDWEB_CLIENT_ID=your-thirdweb-client-id
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your-thirdweb-client-id
# Treasury wallet receiving x402 USDT (defaults to REPORTER_PRIVATE_KEY address if unset)
# X402_PAY_TO=0xYourTreasuryWallet
# Public copy for MiniPay direct-transfer fallback (must match X402_PAY_TO in production)
NEXT_PUBLIC_X402_PAY_TO=0xYourTreasuryWallet
# Settlement: simulated (no real USDT) | confirmed (real on-chain transfers)
X402_SETTLEMENT_MODE=confirmed
NEXT_PUBLIC_X402_SETTLEMENT_MODE=confirmed
X402_ENFORCE=true

# OnchainReporter (Celo mainnet) — backend relayer for publishFinancialReport
REPORTER_PRIVATE_KEY=your-reporter-private-key
ONCHAIN_REPORTER_PROXY_ADDRESS=0x50a8Fc322497e2EAc5489A64ce162E07Fb85E6AB
# CELO_RPC_URL=https://forno.celo.org

# Pinata — IPFS pinning for verified report PDFs
# PINATA_JWT=your-pinata-jwt
# PINATA_GATEWAY=your-subdomain.mypinata.cloud
