# Pooled connection for app runtime (Supabase transaction pooler, port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct/session connection for Prisma CLI migrations & studio (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Get your app ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Public base URL for agent manifests and verification links
NEXT_PUBLIC_APP_URL=https://www.chainalyse.xyz

# Gemini (Google AI) — powers OnFRA chat + dashboard AI summaries
GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=your-gemini-api-key  # alias also supported

# Thirdweb — x402 micropayment settlement on Celo
THIRDWEB_SECRET_KEY=your-thirdweb-secret-key
THIRDWEB_CLIENT_ID=your-thirdweb-client-id
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your-thirdweb-client-id
# X402_PAY_TO=0xYourTreasuryWallet  # optional; defaults to REPORTER_PRIVATE_KEY address
X402_ENFORCE=true                 # require x402 payment on analyze/chat/report APIs

# OnchainReporter (Celo mainnet) — backend relayer for publishFinancialReport
REPORTER_PRIVATE_KEY=your-reporter-private-key
ONCHAIN_REPORTER_PROXY_ADDRESS=0x50a8Fc322497e2EAc5489A64ce162E07Fb85E6AB
# CELO_RPC_URL=https://forno.celo.org
