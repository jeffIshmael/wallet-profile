# FILE: web/.env additions
ONFRA_AGENT_BILLING=off           # required: stops the agent's demo ledger from charging chat users
ONFRA_PRICING_MODE=launch         # free | launch (explain 0.02, statement 0.01) | paid
# ONFRA_PRICING_JSON={"explain_transaction":0.03}
FREE_IN_APP_PAID_TOOLS=true       # false = charge the app too for explain_transaction and statements
# TOOL_FREE_LIMIT=120             # per IP per hour, free tools
# TOOL_IN_APP_PAID_LIMIT=10       # per IP per hour, paid tools used free inside the app
INTEL_AGENT_MODE=auto             # auto | always | off  (chat routing to the new tools)
BUY_ENABLED=false                 # true only where the buy CLI is installed and set up (not on Vercel)
# BUY_ACCOUNT=onfra  BUY_TOKEN=USDT  BUY_DAILY_BUDGET_USD=1
