generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Wallet {
  address   String   @id
  ens       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysisRuns AnalysisRun[]
  chatSessions ChatSession[]
  reports      Report[]
  apiEvents    ApiEvent[]
}

model AnalysisRun {
  id                   String   @id @default(cuid())
  walletAddress        String
  wallet               Wallet   @relation(fields: [walletAddress], references: [address], onDelete: Cascade)

  financialHealthScore Int
  reputationScore      Int
  reputationCategory   String
  riskCategory         String
  incomeLabel          String
  loanRange            String
  loanConfidence       String
  totalValueUsd        Float
  totalTransactions    Int

  walletData           Json
  createdAt            DateTime @default(now())
  expiresAt            DateTime

  @@index([walletAddress, createdAt])
  @@index([expiresAt])
}

model ChatSession {
  id            String   @id @default(cuid())
  walletAddress String
  wallet        Wallet   @relation(fields: [walletAddress], references: [address], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages ChatMessage[]

  @@index([walletAddress, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model Report {
  id                   String   @id @default(cuid())
  walletAddress        String
  wallet               Wallet   @relation(fields: [walletAddress], references: [address], onDelete: Cascade)

  onchainReportId      String   @unique
  reportHash           String
  transactionHash      String
  buyerAddress         String

  financialHealthScore Int
  reputationScore      Int
  loanCapacity         String
  attestation          String

  createdAt            DateTime @default(now())

  @@index([walletAddress, createdAt])
  @@index([buyerAddress])
}

model ApiEvent {
  id            String   @id @default(cuid())
  walletAddress String?
  wallet        Wallet?  @relation(fields: [walletAddress], references: [address], onDelete: SetNull)

  endpoint   String
  status     String
  durationMs Int?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([endpoint, createdAt])
  @@index([createdAt])
}
