# FILE: .env additions for the new intelligence tools
# --- data sources (all free) ---
# SQD_BASE_URL=https://gateway.usebuy.ai/sqd/datasets/celo-mainnet
# CELO_RPC_URL=https://forno.celo.org
# SQD_MAX_ROUNDS=300
# CELO_PRICE_USD=            # optional fallback if CoinGecko is unreachable
# --- statements / IPFS ---
PINATA_JWT=
# IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
# --- Buy purchases (explain_transaction traces only) ---
BUY_ENABLED=false           # set true once `buy setup` was run on this machine
# BUY_ACCOUNT=onfra          # name used in `buy setup --name`
BUY_TOKEN=USDT
BUY_DAILY_BUDGET_USD=1
# BUY_BIN=buy
# --- pricing (middleware/pricing.ts) ---
ONFRA_PRICING_MODE=launch     # free | launch (explain 0.02, statement 0.01) | paid (+0.01 on every intel tool)
# ONFRA_PRICING_JSON={"explain_transaction":0.03,"get_wallet_activity":0}
# --- routing (chains/intel_router.ts) ---
INTEL_AGENT_MODE=auto         # auto | always | off
# INTEL_AGENT_MODEL=gpt-4o-mini
# INTEL_AGENT_MAX_STEPS=5
# --- when the agent runs inside the web app ---
ONFRA_AGENT_BILLING=off       # the web routes handle payment; this turns off the agent's in-memory demo ledger
# Agent dependencies to install in "OnFRA agent": npm i viem pdf-lib
